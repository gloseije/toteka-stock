# Database
DATABASE_URL="postgresql://user:password@localhost:5432/toteka_stock"

# Better Auth
BETTER_AUTH_SECRET="your-secret-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Email (Nodemailer)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user@example.com"
EMAIL_SERVER_PASSWORD="password"
EMAIL_FROM="noreply@toteka.com"

# R2
R2_ACCOUNT_ID="local_dummy_id"
R2_ACCESS_KEY_ID="r2accesskeyid"
R2_SECRET_ACCESS_KEY="r2secretaccesskey"
R2_BUCKET_NAME="r2bucketname"

# Mode beta : quand "true", la limite d'essai de 14 jours n'est pas appliquée.
# Le paiement Chariow reste possible.
NEXT_PUBLIC_APP_BETA="true"

# Chariow (préparation beta, intégration inactive)
CHARIOW_API_KEY=""
CHARIOW_WEBHOOK_SECRET=""
CHARIOW_PRODUCT_ID=""
